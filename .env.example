# Copy to .env (local) or set in Vercel dashboard -> Settings -> Environment Variables.

# --- deployment profile ---------------------------------------------------
# local       = writable disk, uploads enabled (default)
# serverless  = read-only prebuilt index (Vercel), uploads disabled
RAG_DEPLOYMENT=local

# --- LLM backend ----------------------------------------------------------
# ollama = local Ollama daemon | openai = any OpenAI-compatible chat API
RAG_LLM_BACKEND=ollama
RAG_LLM_MODEL=llama3.2:1b
RAG_OLLAMA_URL=http://localhost:11434
RAG_LLM_TEMPERATURE=0.2

# For RAG_LLM_BACKEND=openai (Vercel needs this): OpenAI, Groq, OpenRouter...
# RAG_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# RAG_OPENAI_LLM_MODEL=llama-3.1-8b-instant
# RAG_OPENAI_API_KEY=gsk_...

# --- embeddings -----------------------------------------------------------
# st = sentence-transformers (torch, local) | fastembed = ONNX (serverless)
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- chunking / retrieval tuning ------------------------------------------
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5

# --- agentic RAG (LangGraph) ----------------------------------------------
# auto = agent runs whenever an LLM backend is configured (default)
# on   = force agent (falls back to classic path if it can't run)
# off  = classic single-shot RAG only
RAG_AGENT_MODE=auto
# Max query rewrites when retrieval comes back irrelevant (each = 1 extra LLM call)
RAG_AGENT_MAX_REWRITES=1
# Extra LLM call that checks the draft answer for hallucinations before replying
RAG_AGENT_CHECK_ANSWER=true

# --- upload limits ---------------------------------------------------------
RAG_MAX_UPLOAD_MB=50

# --- CORS / rate limiting --------------------------------------------------
# Comma-separated extra origins; use * only if you really mean it.
# RAG_CORS_ORIGINS=
RAG_RATE_LIMIT_ASK=20
RAG_RATE_LIMIT_SEARCH=30
RAG_RATE_LIMIT_UPLOAD=10
RAG_RATE_LIMIT_ENABLED=true

# --- serverless index ------------------------------------------------------
# Path of the flat-file index bundled with serverless deploys.
# RAG_PREBUILT_INDEX=data/index.json
